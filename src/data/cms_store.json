  "faqs": [
    {
      "question": "What is reelXpress and how does it work?",
      "answer": "reelXpress is an on-demand content creation service that connects you with skilled mobile photographers and videographers. We specialize in capturing high-quality, social-media-ready moments using professional mobile gear, ensuring you get authentic content instantly."
    },
    {
      "question": "What gear do your Reel Makers shoot on?",
      "answer": "All our creators shoot exclusively on the latest flagship iPhone gear paired with professional handheld gimbals, specialized lenses, and high-fidelity wireless microphones for pristine 4K 60fps vertical footage."
    },
    {
      "question": "How fast is 'Delivery in Minutes'?",
      "answer": "Our creators perform on-spot live editing and color grading directly at your shoot venue. You receive high-definition, post-ready reels before your event concludes or within minutes post-shoot via cloud link."
    },
    {
      "question": "Can I book for weddings, vehicle deliveries, and brand launches?",
      "answer": "Yes! We offer dedicated formats for Quick Hourly Shoots, Vehicle Delivery & Rollouts, Wedding & Ceremony packages, and Commercial Brand & Store Launches."
    },
    {
      "question": "Can I book last minute? Like, the day before?",
      "answer": "Yes — clients do this regularly! As long as a verified creator is available in your city zone, we can lock down your slot within minutes. We have successfully arranged same-day shoots multiple times across Hyderabad, Bengaluru, Chennai, Vizag, and Vijayawada."
    },
    {
      "question": "Can I see my Reel Maker's portfolio before the shoot?",
      "answer": "Absolutely. We happily share creator profiles and sample reels upon request when booking, ensuring their specific aesthetic, camera movement, and pacing align seamlessly with your vision."
    },
    {
      "question": "How does the CMS live test work?",
      "answer": "Every change saved in the CMS persists to the persistent server store and immediately synchronizes to the live site.",
      "category": "General",
      "enabled": true,
      "order": 1,
      "id": "faqs_1794556695791",
      "_deleted": true,
      "updatedAt": "2026-11-13T07:58:31.614Z",
      "updatedBy": "admin@reelxpress.com"
    }
  ],
